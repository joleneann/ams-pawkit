node-linker=hoisted
public-hoist-pattern[]=*
# React + react-dom must NOT be hoisted to the workspace root. The dashboard
# (Next.js 14) needs React 18, the parent app (Expo SDK 54 / RN 0.81) needs
# React 19. Hoisting either to root makes Next.js's webpack resolve the
# wrong one during prerender, causing a `useRef on null` crash on /404 and
# /500. Negative patterns below keep React isolated per workspace.
# Locked 2026-05-19 after Vercel deploy failures.
public-hoist-pattern[]=!react
public-hoist-pattern[]=!react-dom
strict-peer-dependencies=false
auto-install-peers=true
