# Pawkit v0 — environment variables template
# Copy this file to .env.local in each app folder and fill in the real values.
# NEVER commit .env.local — it's git-ignored.
#
# Real values live in the Supabase dashboard:
# https://supabase.com/dashboard/project/pevofxnfjcvmamdcfkus/settings/api

# ---- Next.js dashboard (apps/dashboard/.env.local) ----
# Next.js requires NEXT_PUBLIC_ prefix for client-side exposure
NEXT_PUBLIC_SUPABASE_URL=https://pevofxnfjcvmamdcfkus.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... # from dashboard → Settings → API → anon public

# ---- Expo pet-parent app (apps/petparent/.env.local) ----
# Expo requires EXPO_PUBLIC_ prefix for client-side exposure
EXPO_PUBLIC_SUPABASE_URL=https://pevofxnfjcvmamdcfkus.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ... # same anon key as above

# ---- Seed scripts (supabase/.env.local) — SERVICE ROLE, never client-side ----
# This key bypasses RLS. Use ONLY in seed scripts and server-side admin tooling.
SUPABASE_SERVICE_ROLE_KEY=eyJ... # from dashboard → Settings → API → service_role secret
SUPABASE_URL=https://pevofxnfjcvmamdcfkus.supabase.co
